{
  "manifest_version": 3,
  "name": "Convert Image",
  "version": "1.0.2",
  "description": "Save images as PNG or JPG, or copy as PNG.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "downloads",
    "clipboardWrite",
    "scripting",
    "notifications",
    "offscreen"
  ],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
